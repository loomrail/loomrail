{
  "name": "loomrail",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=24.19 <25",
    "pnpm": "11.21.0"
  },
  "scripts": {
    "build": "pnpm -r --sort --if-present build",
    "dev": "pnpm build && pnpm --filter @loomrail/cli start",
    "start": "pnpm --filter @loomrail/cli start",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "pnpm build && eslint .",
    "typecheck": "pnpm build && tsc -p tsconfig.json --noEmit && pnpm -r --sort --if-present typecheck",
    "test": "pnpm -r --sort --if-present test",
    "test:unit": "pnpm -r --sort --if-present test:unit",
    "test:integration": "pnpm -r --sort --if-present test:integration",
    "test:e2e": "playwright test",
    "test:public-readiness": "node scripts/check-public-tree.mjs",
    "verify": "pnpm format:check && pnpm test:public-readiness && pnpm lint && pnpm typecheck && pnpm test"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.55.0",
    "@types/node": "^24.0.0",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^6.1.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^17.11.0",
    "prettier": "^3.6.0",
    "typescript": "^6.0.0",
    "typescript-eslint": "^8.40.0",
    "vitest": "^4.1.0"
  }
}
